# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
# Docker
docker-compose.yaml
Dockerfile
.dockerignore
# Development files
.env
.env.example
*.log
# Minikube/local dev
launch-minikube.sh
# Helm dependency charts (managed by helm dependency)
# charts/*.tgz  # REMOVED: This was preventing dependencies from being included!
values.local.yaml
